# 应用基础信息，后端 FastAPI 配置会读取。
APP_NAME=Full Stack Admin Template
APP_ENV=local

# 后端接口路由前缀。例如用户接口会挂在 /api/users。
API_PREFIX=/api

# 宿主机端口，由 start.sh 和 Docker Compose 使用。
# API_PORT：浏览器访问 API 和接口文档的端口，例如 http://localhost:8000。
# WEB_PORT：浏览器访问本地 Next.js 开发服务的端口。
# POSTGRES_PORT：宿主机访问 PostgreSQL 的端口，映射到容器内固定的 5432。
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5436

# 对外访问源地址，可由上面的端口推导；不填时 start.sh 会自动兜底。
# API_ORIGIN：API 服务地址，不包含 API_PREFIX。
# WEB_ORIGIN：前端页面地址，主要用于后端 CORS 放行。
API_ORIGIN=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# 本地直接运行 API 时可使用的数据库连接串。
# Docker Compose 启动 API 时会清空 DATABASE_URL，改用下面的 POSTGRES_* 变量连接容器数据库。
DATABASE_URL=sqlite:///./app.db

# 后端安全和运行配置。
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# 初始化管理员账号；SEED_ADMIN=1 时启动后端会自动创建或更新。
SEED_ADMIN=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_FULL_NAME=Template Admin

# 前端浏览器访问后端的完整 API 基础地址。
# 本地开发通常等于 API_ORIGIN + API_PREFIX。
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# PostgreSQL 容器数据库配置。
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
